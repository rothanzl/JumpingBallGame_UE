.vs/
.idea/
*.sln
*.xcworkspace/
*.xcodeproj/
*.code-workspace
.vscode/
*.DotSettings.user

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
*.bak
*.swp
